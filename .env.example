# NEXUSIA — IA própria do zero. Copie para .env e preencha. NUNCA commite .env.
DISCORD_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./nexusia.db
# Exemplo Neon (Postgres pooler):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:XXXX@ep-empty-wildflower-b6ws5leu-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
MODEL_DIRECTORY=./checkpoints/active
CANDIDATE_DIRECTORY=./checkpoints/candidates
TOKENIZER_PATH=./checkpoints/active/tokenizer.json
TOKENIZER_DIR=./checkpoints/active
TRAINING_DATA_DIRECTORY=./datasets/prepared
TRAINING_ENABLED=false
DISCORD_TRAINING_INGESTION_ENABLED=false
LOG_LEVEL=INFO
MAX_GENERATION_TOKENS=48
MAX_INPUT_TOKENS=256
TRAINING_MAX_RAM_MB=1500
TRAINING_INTERVAL=3600
GUILD_ALLOWLIST=
# Bots-treinadores autorizados a falar com a IA (exceção anti-loop, IDs por vírgula).
TRAINER_BOT_IDS=
# Canal onde o bot conversa sem comando (IDs separados por vírgula).
CHAT_CHANNEL_ID=
